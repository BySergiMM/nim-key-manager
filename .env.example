# ============================================================
# NIM Key Manager - Environment variables
# In production (Render) these are provisioned automatically
# by render.yaml. This file is for reference and local dev.
# ============================================================

# --- Core ---
# "development" (also dev, local, test, testing) is for your own machine: it skips the start-up
# check that refuses placeholder or short secrets. Any other value is treated as production.
ENVIRONMENT=production
DEBUG=false

# --- Security (REQUIRED) ---
# Random values of at least 32 characters, e.g. `openssl rand -base64 48`; a 256-bit key is
# derived from the master key via HKDF-SHA256. Outside ENVIRONMENT=development the service
# refuses to start while a secret is empty, shorter than that, or one of these placeholders.
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_MASTER_KEY=change-me-to-another-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (REQUIRED) ---
# postgres:// URLs (Render/Heroku style) are normalized automatically.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/nimkeys
# Create tables on startup (dev/tests only; production uses Alembic).
AUTO_CREATE_TABLES=false

# --- Bootstrap admin (created on first startup if no users exist) ---
# The placeholder password is refused outside ENVIRONMENT=development.
FIRST_ADMIN_EMAIL=you@example.com
FIRST_ADMIN_PASSWORD=change-me-strong-password

# --- NVIDIA validation endpoint (official, read-only) ---
NVIDIA_VALIDATION_URL=https://integrate.api.nvidia.com/v1/models

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
# Every route without a limit of its own, per client address and URL path (/health is exempt).
RATE_LIMIT_DEFAULT=120/minute
# Login and key dispensing have their own, independent limits.
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_DISPENSE=60/minute

# --- Client IP behind a reverse proxy ---
# The rate limiter and the audit log use the client address uvicorn derives. It believes
# X-Forwarded-For only from these peers (comma-separated IPs / CIDR ranges) and takes the
# right-most entry that is not in the list. Never "*": every client could then choose its own
# IP and bypass the rate limits. Default: 127.0.0.1 (proxy on the same host).
# See docs/deployment.md#client-ip-and-proxy-headers
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- Background jobs ---
SCHEDULER_ENABLED=true
VALIDATION_INTERVAL_HOURS=6
EXPIRY_WARNING_DAYS=7

# --- CORS (JSON list) ---
CORS_ORIGINS=["*"]

# ============================================================
# Claude MCP connector (OAuth 2.1 custom connector)
# ============================================================
# The connector is optional: without the OAuth credentials below the service still starts and
# serves the API and dashboard; /mcp just stays off (a warning is logged).
MCP_ENABLED=true
MCP_AUTH_ENABLED=true
# Identity provider for the "Connect" flow: github | google
MCP_AUTH_PROVIDER=github

# Public URL clients use to reach this service. On Render it is taken from
# RENDER_EXTERNAL_URL automatically; set it explicitly for other hosts / local.
# PUBLIC_BASE_URL=https://your-service.onrender.com

# GitHub OAuth App credentials (Settings -> Developer settings -> OAuth Apps).
# Authorization callback URL must be:  <PUBLIC_BASE_URL>/auth/callback
MCP_GITHUB_CLIENT_ID=
MCP_GITHUB_CLIENT_SECRET=
# For Google instead, set MCP_AUTH_PROVIDER=google and:
# MCP_GOOGLE_CLIENT_ID=
# MCP_GOOGLE_CLIENT_SECRET=

# Who may use the connector, comma-separated: your NUMERIC GitHub user id (not your login:
# a login can be renamed and then registered by somebody else) and/or an e-mail address.
#   curl -s https://api.github.com/users/YOUR-LOGIN | jq .id
# For Google: your verified e-mail, or the account's `sub`.
# Fail-closed: if empty, nobody is allowed when auth is enabled.
# See docs/connector.md#migrating-an-existing-allow-list
MCP_ALLOWED_IDENTITIES=
# Provision an app user on first login for allow-listed identities.
MCP_AUTO_PROVISION=true
# Role granted to auto-provisioned users: admin | manager | viewer. A viewer cannot dispense,
# register or delete keys; raise it deliberately.
MCP_DEFAULT_ROLE=viewer

# Stable key to sign the JWTs FastMCP issues to Claude (falls back to JWT_SECRET).
# MCP_OAUTH_JWT_SIGNING_KEY=change-me-to-a-long-random-string

# Optional: persist OAuth clients/tokens across restarts (else in-memory).
# MCP_REDIS_URL=redis://localhost:6379
# MCP_STORAGE_ENCRYPTION_KEY=   # Fernet key (base64, 32 bytes) to encrypt at rest

# Optional Host/Origin protection overrides (comma-separated). Defaults derive
# from PUBLIC_BASE_URL plus loopback.
# MCP_ALLOWED_HOSTS=your-service.onrender.com
# MCP_ALLOWED_ORIGINS=https://claude.ai
