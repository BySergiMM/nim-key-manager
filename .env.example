# ============================================================
# NIM Key Manager - Environment variables (reference)
#
# You normally do NOT need this file:
#   * a local install keeps generated settings in <NIMKM_HOME>/config.env
#     (`nimkm config path` prints the location, `nimkm config set K=V` edits it)
#   * the container generates what is missing into /data
#   * Render provisions everything from render.yaml
#
# Precedence: real environment variables  >  ./.env  >  config.env
# Copy this file to .env only for development from a source checkout.
# ============================================================

# --- Core ---
# Anything other than development/test enforces real secrets (see below).
ENVIRONMENT=production
DEBUG=false

# --- HTTP server (nimkm serve) ---
HOST=127.0.0.1
PORT=8000

# --- Security (REQUIRED outside development) ---
# Any long random string; a 256-bit key is derived via HKDF-SHA256.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production while these hold the placeholder values.
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_MASTER_KEY=change-me-to-another-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Defaults to SQLite inside NIMKM_HOME when unset, so the location never depends
# on the directory you started the process from.
# postgres:// URLs (Render/Heroku style) are normalized automatically.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/nimkeys
# Create tables on startup (dev/tests only; everything else uses `nimkm migrate`).
AUTO_CREATE_TABLES=false

# --- Bootstrap admin (created on first startup if no users exist) ---
FIRST_ADMIN_EMAIL=you@example.com
FIRST_ADMIN_PASSWORD=change-me-strong-password

# --- NVIDIA validation endpoint (official, read-only) ---
NVIDIA_VALIDATION_URL=https://integrate.api.nvidia.com/v1/models

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_DISPENSE=60/minute

# --- Background jobs ---
SCHEDULER_ENABLED=true
VALIDATION_INTERVAL_HOURS=6
EXPIRY_WARNING_DAYS=7

# --- CORS (JSON list) ---
CORS_ORIGINS=["*"]

# ============================================================
# REMOTE MCP connector (OAuth 2.1 custom connector over HTTPS)
#
# Local clients do NOT need any of this: `nimkm mcp setup` registers
# the stdio transport, which has no OAuth and no public URL.
# These variables are only for a deployed instance that a remote
# client must reach; `nimkm mcp oauth` fills them in interactively.
# Without credentials the connector stays idle and the rest of the
# service starts normally.
# ============================================================
MCP_ENABLED=true
MCP_AUTH_ENABLED=true
# Identity provider for the "Connect" flow: github | google
MCP_AUTH_PROVIDER=github

# Public URL clients use to reach this service. On Render it is taken from
# RENDER_EXTERNAL_URL automatically; set it explicitly for other hosts / local.
# PUBLIC_BASE_URL=https://your-service.onrender.com

# GitHub OAuth App credentials (Settings -> Developer settings -> OAuth Apps).
# Authorization callback URL must be:  <PUBLIC_BASE_URL>/auth/callback
MCP_GITHUB_CLIENT_ID=
MCP_GITHUB_CLIENT_SECRET=
# For Google instead, set MCP_AUTH_PROVIDER=google and:
# MCP_GOOGLE_CLIENT_ID=
# MCP_GOOGLE_CLIENT_SECRET=

# Who may use the connector: your GitHub login and/or e-mail (comma-separated).
# Fail-closed: if empty, nobody is allowed when auth is enabled.
MCP_ALLOWED_IDENTITIES=your-github-login
# Provision an app user on first login for allow-listed identities.
MCP_AUTO_PROVISION=true
# Role granted to auto-provisioned users: admin | manager | viewer
MCP_DEFAULT_ROLE=admin

# Stable key to sign the JWTs FastMCP issues to Claude (falls back to JWT_SECRET).
# MCP_OAUTH_JWT_SIGNING_KEY=change-me-to-a-long-random-string

# Optional: persist OAuth clients/tokens across restarts (else in-memory).
# MCP_REDIS_URL=redis://localhost:6379
# MCP_STORAGE_ENCRYPTION_KEY=   # Fernet key (base64, 32 bytes) to encrypt at rest

# Optional Host/Origin protection overrides (comma-separated). Defaults derive
# from PUBLIC_BASE_URL plus loopback.
# MCP_ALLOWED_HOSTS=your-service.onrender.com
# MCP_ALLOWED_ORIGINS=https://claude.ai
